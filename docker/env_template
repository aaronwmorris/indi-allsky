### Copy this file to .env before starting containers: cp env_template .env ###

# System timezone
TZ=America/New_York

# APT Repository channel for image builds: nightly or stable
INDIALLSKY_APT_CHANNEL=nightly

# Optional: Use pre-built Docker images from GitHub Container Registry (GHCR) instead of building locally
#INDIALLSKY_IMAGE=ghcr.io/aaronwmorris/indi-allsky:stable
#INDIALLSKY_IMAGE=ghcr.io/aaronwmorris/indi-allsky:nightly

# Primary INDI camera driver
INDIALLSKY_INDI_CCD_DRIVER=indi_simulator_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_asi_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_qhy_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_toupcam_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_altaircam_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_ogmacam_ccd_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_omegonprocam_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_playerone_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_svbony_ccd
#INDIALLSKY_INDI_CCD_DRIVER=indi_libcamera_ccd

# Optional INDI GPS driver
INDIALLSKY_INDI_GPS_DRIVER=

# Shared image folder (inside containers)
INDIALLSKY_IMAGE_FOLDER=/var/www/html/allsky/images

# Dark frame capture mode (set to "true" to run dark frame acquisition)
INDIALLSKY_DARK_CAPTURE_ENABLE=false
INDIALLSKY_DARK_CAPTURE_MODE=sigmaclip
INDIALLSKY_DARK_CAPTURE_BITMAX=16
INDIALLSKY_DARK_CAPTURE_DAYTIME=--daytime

# Web interface security and access control
INDIALLSKY_FLASK_AUTH_ALL_VIEWS=false       # Require login to view all pages
INDIALLSKY_FLASK_AUTH_MEDIA_VIEWS=false     # Require login to view images/videos
INDIALLSKY_FLASK_LOCAL_AUTH_ENABLE=true     # Enable local username/password login
INDIALLSKY_FLASK_LOGIN_DISABLED=false       # DANGER: Set true to disable all authentication
INDIALLSKY_FLASK_SESSION_COOKIE_SECURE=true # Set false only if running plain HTTP without TLS

# Flask secret and encryption keys.
# Leave blank to have the container automatically generate and persist secure keys on first boot.
INDIALLSKY_FLASK_SECRET_KEY=
INDIALLSKY_FLASK_PASSWORD_KEY=

# OpenID Connect (OIDC / OAuth2 / SSO) Authentication
# Wiki: https://github.com/aaronwmorris/indi-allsky/wiki/OIDC-OAuth2-SSO-Auth
INDIALLSKY_OIDC_ENABLE=false
INDIALLSKY_OIDC_AUTO_LOGIN=false            # Automatically redirect login page to OIDC provider
INDIALLSKY_OIDC_PROVIDER_NAME=SSO           # Provider name on login button (e.g. Authentik, Keycloak, Google)
INDIALLSKY_OIDC_CLIENT_ID=
INDIALLSKY_OIDC_CLIENT_SECRET=
INDIALLSKY_OIDC_DISCOVERY_ENDPOINT=         # e.g. https://auth.example.com/.well-known/openid-configuration
INDIALLSKY_OIDC_USERINFO_ENDPOINT=
INDIALLSKY_OIDC_USERNAME_CLAIM=preferred_username
INDIALLSKY_OIDC_SCOPES="openid email profile offline_access"
INDIALLSKY_OIDC_PKCE=true
INDIALLSKY_OIDC_LOGO_URL=
# Comma-separated or JSON list of allowed / admin groups and users
INDIALLSKY_OIDC_ALLOWED_GROUPS=
INDIALLSKY_OIDC_ADMIN_GROUPS=
INDIALLSKY_OIDC_ALLOWED_USERS=
INDIALLSKY_OIDC_ADMIN_USERS=

# Initial Web UI administrator account credentials
# Strongly recommended: Change the admin password before starting containers (minimum 8 characters)
INDIALLSKY_WEB_USER=admin
INDIALLSKY_WEB_PASS=CHANGE_ME_ADMIN_PASSWORD
INDIALLSKY_WEB_NAME=Admin User
INDIALLSKY_WEB_EMAIL=admin@example.org

# Optional: Mosquitto MQTT broker credentials
# If you comment out the mosquitto container in docker-compose.yaml, these credentials are not used.
# If connecting to an external broker, you can set INDIALLSKY_MQTT_HOST or configure it in the web UI.
#INDIALLSKY_MQTT_HOST=mosquitto.indi.allsky
INDIALLSKY_MOSQUITTO_USER=admin
INDIALLSKY_MOSQUITTO_PASS=CHANGE_ME_MQTT_PASSWORD

# Set to "true" on first run if you want to generate an API key for the user
INDIALLSKY_WEB_GENERATE_APIKEY=false

# MariaDB database settings
INDIALLSKY_MARIADB_HOST=mariadb.indi.allsky
INDIALLSKY_MARIADB_PORT=3306
INDIALLSKY_MARIADB_SSL=false
INDIALLSKY_MARIADB_CHARSET=utf8mb4
INDIALLSKY_MARIADB_COLLATION=utf8mb4_unicode_ci

MARIADB_RANDOM_ROOT_PASSWORD=yes
MARIADB_DATABASE=indi_allsky
MARIADB_USER=indi_allsky_own
# Required: Set a secure password for MariaDB before starting containers
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Gunicorn proxy settings
FORWARDED_ALLOW_IPS="*"
