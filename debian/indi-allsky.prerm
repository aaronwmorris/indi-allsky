#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop background services so SQLite database is not locked during upgrade/migration
        if [ -d /run/systemd/system ]; then
            systemctl stop indi-allsky.service || true
            systemctl stop indiserver.service || true
            systemctl stop gunicorn-indi-allsky.service || true
            systemctl stop indi-allsky-ssl-renew.timer || true
            systemctl disable indi-allsky-ssl-renew.timer || true
        fi

        # Clean up Python bytecode files created dynamically at runtime in /usr/share/indi-allsky and /var/lib/indi-allsky/venv
        if [ -d "/usr/share/indi-allsky" ]; then
            find /usr/share/indi-allsky -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
            find /usr/share/indi-allsky -type f -name "*.pyc" -delete 2>/dev/null || true
            find /usr/share/indi-allsky -type f -name "*.pyo" -delete 2>/dev/null || true
        fi
        if [ -d "/var/lib/indi-allsky/venv" ]; then
            find /var/lib/indi-allsky/venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
            find /var/lib/indi-allsky/venv -type f -name "*.pyc" -delete 2>/dev/null || true
            find /var/lib/indi-allsky/venv -type f -name "*.pyo" -delete 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
