[Unit]
Description=INDI Allsky Model Context Protocol (MCP) Service
After=network-online.target indi-allsky.service
Wants=network-online.target

[Service]
Type=simple
User=indi-allsky
Group=indi-allsky
WorkingDirectory=/var/lib/indi-allsky/working/indi-allsky
Environment="PYTHONPATH=/usr/share/indi-allsky"
EnvironmentFile=-/etc/indi-allsky/indi-allsky.env
ExecStart=/var/lib/indi-allsky/venv/bin/python3 /usr/share/indi-allsky/misc/indi_allsky_mcp.py --transport sse --host 0.0.0.0 --port 8000
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
PrivateTmp=true
UMask=0022

[Install]
WantedBy=multi-user.target
