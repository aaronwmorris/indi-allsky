#!/usr/bin/make -f

export PYBUILD_NAME=indi-allsky

%:
	dh $@ --with python3

override_dh_auto_build:
	# Clone and compile pyindi-client for python3-pyindi-client package
	mkdir -p debian/pyindi-build
	if [ ! -f debian/pyindi-build/setup.py ]; then \
		git clone --depth 1 https://github.com/indilib/pyindi-client.git debian/pyindi-build; \
		(cd debian/pyindi-build && git checkout d8ad88f 2>/dev/null || true); \
	fi
	(cd debian/pyindi-build && python3 setup.py build)

	# Pre-download PyPI dependencies as wheels into debian/wheels/ for offline cache
	mkdir -p debian/wheels
	python3 -m pip wheel -r requirements/requirements_latest.txt -w debian/wheels/

override_dh_auto_install:
	# Install application source into /usr/share/indi-allsky
	mkdir -p debian/indi-allsky/usr/share/indi-allsky
	cp -r allsky.py app.py config.py flask.json_template darks.py indi_allsky migrations misc log html requirements service debian/indi-allsky/usr/share/indi-allsky/
	
	# Install python3-pyindi-client into /usr/lib/python3/dist-packages
	mkdir -p debian/python3-pyindi-client
	(cd debian/pyindi-build && python3 setup.py install --root=$(CURDIR)/debian/python3-pyindi-client --install-layout=deb --no-compile)

	# Install pre-compiled PyPI python wheels into the separate indi-allsky-wheels package
	mkdir -p debian/indi-allsky-wheels/usr/share/indi-allsky/wheels
	cp -r debian/wheels/* debian/indi-allsky-wheels/usr/share/indi-allsky/wheels/ 2>/dev/null || true

	# Install bundled pre-compiled INDI driver .deb packages if available
	mkdir -p debian/indi-allsky/usr/share/indi-allsky/debs
	cp -r debian/debs/* debian/indi-allsky/usr/share/indi-allsky/debs/ 2>/dev/null || true

	# Install executable launcher symlinks
	mkdir -p debian/indi-allsky/usr/bin
	ln -sf /var/lib/indi-allsky/venv/bin/python3 debian/indi-allsky/usr/bin/indi-allsky-python

override_dh_installsystemd:
	# Enable indi-allsky, gunicorn, and indiserver services
	dh_installsystemd -pindi-allsky --name=indi-allsky
	dh_installsystemd -pindi-allsky --name=gunicorn-indi-allsky
	dh_installsystemd -pindi-allsky --name=indiserver

override_dh_auto_clean:
	rm -rf debian/pyindi-build debian/wheels
	dh_auto_clean



