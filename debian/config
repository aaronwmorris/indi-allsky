#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_capb backup

# Pre-populate debconf answers from existing /etc/indi-allsky/flask.json if present
FLASK_JSON="/etc/indi-allsky/flask.json"
INDISERVER_ENV="/etc/indi-allsky/indiserver.env"

if [ -f "$FLASK_JSON" ] && command -v jq >/dev/null 2>&1; then
    CAMERA_INT=$(jq -r '.CAMERA_INTERFACE // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$CAMERA_INT" ]; then
        db_set indi-allsky/camera_interface "$CAMERA_INT" || true
    fi

    CCD_DRV=$(jq -r '.CCD_DRIVER // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$CCD_DRV" ]; then
        db_set indi-allsky/ccd_driver "$CCD_DRV" || true
    fi

    HTTP_P=$(jq -r '.HTTP_PORT // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$HTTP_P" ]; then
        db_set indi-allsky/http_port "$HTTP_P" || true
    fi

    HTTPS_P=$(jq -r '.HTTPS_PORT // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$HTTPS_P" ]; then
        db_set indi-allsky/https_port "$HTTPS_P" || true
    fi

    INDI_P=$(jq -r '.INDI_PORT // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$INDI_P" ]; then
        db_set indi-allsky/indi_port "$INDI_P" || true
    fi

    AUTH_ALL=$(jq -r '.INDI_ALLSKY_AUTH_ALL_VIEWS // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ "$AUTH_ALL" = "true" ] || [ "$AUTH_ALL" = "false" ]; then
        db_set indi-allsky/web_auth_all_views "$AUTH_ALL" || true
    else
        db_set indi-allsky/web_auth_all_views "false" || true
    fi

    OIDC_EN=$(jq -r '.OIDC_ENABLE // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ "$OIDC_EN" = "true" ] || [ "$OIDC_EN" = "false" ]; then
        db_set indi-allsky/oidc_enable "$OIDC_EN" || true
    fi

    OIDC_ID=$(jq -r '.OIDC_CLIENT_ID // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$OIDC_ID" ]; then
        db_set indi-allsky/oidc_client_id "$OIDC_ID" || true
    fi

    OIDC_DISC=$(jq -r '.OIDC_DISCOVERY_ENDPOINT // empty' "$FLASK_JSON" 2>/dev/null || true)
    if [ -n "$OIDC_DISC" ]; then
        db_set indi-allsky/oidc_discovery_url "$OIDC_DISC" || true
    fi
fi

if [ -f "$INDISERVER_ENV" ]; then
    GPS_DRV=$(grep -E '^GPS_DRIVER=' "$INDISERVER_ENV" 2>/dev/null | cut -d= -f2- | tr -d '"' || true)
    if [ -n "$GPS_DRV" ]; then
        db_set indi-allsky/gps_driver "$GPS_DRV" || true
    fi
fi

# Pre-populate observatory coordinates from SQLite database if present
DB_FILE="/var/lib/indi-allsky/indi-allsky.sqlite"
if [ -f "$DB_FILE" ] && command -v sqlite3 >/dev/null 2>&1; then
    CFG_JSON=$(sqlite3 "$DB_FILE" "SELECT data FROM config ORDER BY id DESC LIMIT 1;" 2>/dev/null || true)
    if [ -n "$CFG_JSON" ] && command -v jq >/dev/null 2>&1; then
        DB_LAT=$(echo "$CFG_JSON" | jq -r '.LOCATION_LATITUDE // empty' 2>/dev/null || true)
        [ -n "$DB_LAT" ] && db_set indi-allsky/latitude "$DB_LAT" || true
        DB_LON=$(echo "$CFG_JSON" | jq -r '.LOCATION_LONGITUDE // empty' 2>/dev/null || true)
        [ -n "$DB_LON" ] && db_set indi-allsky/longitude "$DB_LON" || true
        DB_ELEV=$(echo "$CFG_JSON" | jq -r '.LOCATION_ELEVATION // empty' 2>/dev/null || true)
        [ -n "$DB_ELEV" ] && db_set indi-allsky/elevation "$DB_ELEV" || true
    fi
fi

# Check if an existing configuration is present and prompt to reuse
EXISTING_CONFIG=0
if [ -f "$FLASK_JSON" ] || [ -f "$DB_FILE" ] || [ -f "$INDISERVER_ENV" ]; then
    EXISTING_CONFIG=1
fi

if [ "$EXISTING_CONFIG" = "1" ]; then
    db_set indi-allsky/reuse_existing_config true || true
    db_input high indi-allsky/reuse_existing_config || true
    if db_go; then
        db_get indi-allsky/reuse_existing_config
        if [ "$RET" = "true" ]; then
            exit 0
        fi
    fi
else
    db_set indi-allsky/reuse_existing_config false || true
fi

STATE=1
while [ "$STATE" -ge 1 ] && [ "$STATE" -le 7 ]; do
    case "$STATE" in
        1)
            # Step 1: Camera Interface
            db_input high indi-allsky/camera_interface || true
            if db_go; then
                STATE=2
            else
                STATE=0
            fi
            ;;
        2)
            # Step 2: Camera Sub-Settings (CCD Driver, Sensor Profile, GPS Driver)
            db_get indi-allsky/camera_interface
            CAM_INT="$RET"

            if [ "$CAM_INT" = "libcamera" ]; then
                db_input high indi-allsky/libcamera_sensor || true
                if db_go; then
                    STATE=3
                else
                    STATE=1
                fi
            elif [ "$CAM_INT" = "indi" ] || [ "$CAM_INT" = "indi_accumulator" ] || [ "$CAM_INT" = "indi_passive" ]; then
                db_input high indi-allsky/ccd_driver || true
                db_input high indi-allsky/gps_driver || true
                if db_go; then
                    STATE=3
                else
                    STATE=1
                fi
            else
                # For simulator, test patterns, pycurl, mqtt
                if [ "$CAM_INT" = "simulator" ]; then
                    db_set indi-allsky/ccd_driver "indi_simulator_ccd" || true
                fi
                STATE=3
            fi
            ;;
        3)
            # Step 3: Ports
            db_input high indi-allsky/http_port || true
            db_input high indi-allsky/https_port || true
            db_input high indi-allsky/indi_port || true
            if db_go; then
                STATE=4
            else
                STATE=2
            fi
            ;;
        4)
            # Step 4: Web Auth Scope & Initial Admin Account (skipped if an admin user already exists)
            db_input high indi-allsky/web_auth_all_views || true

            DB_HAS_ADMIN=0
            if [ -f "$DB_FILE" ] && command -v sqlite3 >/dev/null 2>&1; then
                ADMIN_COUNT=$(sqlite3 "$DB_FILE" "SELECT count(*) FROM user WHERE admin = 1 AND username != 'system';" 2>/dev/null || echo "0")
                if [ "${ADMIN_COUNT:-0}" -gt 0 ]; then
                    DB_HAS_ADMIN=1
                fi
            fi

            if [ "$DB_HAS_ADMIN" = "0" ]; then
                db_input high indi-allsky/web_user || true
                db_input high indi-allsky/web_name || true
                db_input high indi-allsky/web_pass || true
                db_input high indi-allsky/web_pass_confirm || true
                db_input high indi-allsky/web_email || true
            fi

            if db_go; then
                if [ "$DB_HAS_ADMIN" = "0" ]; then
                    db_get indi-allsky/web_pass
                    PASS="$RET"
                    db_get indi-allsky/web_pass_confirm
                    PASS_CONFIRM="$RET"

                    # If preseeded with web_pass but web_pass_confirm is empty, copy web_pass to confirm
                    if [ -n "$PASS" ] && [ -z "$PASS_CONFIRM" ]; then
                        db_fget indi-allsky/web_pass_confirm seen
                        if [ "$RET" = "false" ]; then
                            PASS_CONFIRM="$PASS"
                            db_set indi-allsky/web_pass_confirm "$PASS" || true
                        fi
                    fi

                    # If user entered a password interactively, validate length and matching
                    if [ -n "$PASS" ]; then
                        if [ "${#PASS}" -lt 8 ]; then
                            db_fset indi-allsky/password_too_short seen false || true
                            db_input critical indi-allsky/password_too_short || true
                            db_go || true
                            db_reset indi-allsky/web_pass || true
                            db_reset indi-allsky/web_pass_confirm || true
                            continue
                        fi
                        if [ "$PASS" != "$PASS_CONFIRM" ]; then
                            db_fset indi-allsky/password_mismatch seen false || true
                            db_input critical indi-allsky/password_mismatch || true
                            db_go || true
                            db_reset indi-allsky/web_pass || true
                            db_reset indi-allsky/web_pass_confirm || true
                            continue
                        fi
                    fi
                fi
                STATE=5
            else
                STATE=3
            fi
            ;;
        5)
            # Step 5: Observatory Location with Range Validation
            db_input high indi-allsky/latitude || true
            db_input high indi-allsky/longitude || true
            db_input high indi-allsky/elevation || true
            if db_go; then
                db_get indi-allsky/latitude
                LAT="$RET"
                db_get indi-allsky/longitude
                LON="$RET"

                # Validate Latitude (-90 to 90)
                if [ -n "$LAT" ]; then
                    INVALID_LAT=$(awk -v lat="$LAT" 'BEGIN {
                        if (lat ~ /^-?[0-9]+(\.[0-9]+)?$/ && (lat + 0) >= -90.0 && (lat + 0) <= 90.0) exit 0;
                        exit 1;
                    }' 2>/dev/null && echo "0" || echo "1")
                    if [ "$INVALID_LAT" = "1" ]; then
                        db_fset indi-allsky/invalid_latitude seen false || true
                        db_input critical indi-allsky/invalid_latitude || true
                        db_go || true
                        continue
                    fi
                fi

                # Validate Longitude (-180 to 180)
                if [ -n "$LON" ]; then
                    INVALID_LON=$(awk -v lon="$LON" 'BEGIN {
                        if (lon ~ /^-?[0-9]+(\.[0-9]+)?$/ && (lon + 0) >= -180.0 && (lon + 0) <= 180.0) exit 0;
                        exit 1;
                    }' 2>/dev/null && echo "0" || echo "1")
                    if [ "$INVALID_LON" = "1" ]; then
                        db_fset indi-allsky/invalid_longitude seen false || true
                        db_input critical indi-allsky/invalid_longitude || true
                        db_go || true
                        continue
                    fi
                fi

                STATE=6
            else
                STATE=4
            fi
            ;;
        6)
            # Step 6: OIDC SSO Configuration
            db_input high indi-allsky/oidc_enable || true
            if db_go; then
                db_get indi-allsky/oidc_enable
                if [ "$RET" = "true" ]; then
                    db_input high indi-allsky/oidc_client_id || true
                    db_input high indi-allsky/oidc_client_secret || true
                    db_input high indi-allsky/oidc_discovery_url || true
                    if ! db_go; then
                        STATE=6
                        continue
                    fi
                fi
                STATE=7
            else
                STATE=5
            fi
            ;;
        7)
            # Step 7: System Performance & Hardware Tweaks
            db_input high indi-allsky/install_mosquitto || true
            db_input high indi-allsky/disable_leds || true
            db_input high indi-allsky/enable_watchdog || true
            db_input high indi-allsky/system_optimize || true
            if db_go; then
                STATE=8
            else
                STATE=6
            fi
            ;;
    esac
done

exit 0
