#!/bin/bash
###############################################################################
# indi-allsky-ctl: Command-line control & maintenance utility for indi-allsky
###############################################################################
set -e

# Resolve APP_DIR dynamically (supports installed package and git source tree)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$SCRIPT_DIR" = "/usr/bin" ] || [ "$SCRIPT_DIR" = "/usr/local/bin" ]; then
    APP_DIR="/usr/share/indi-allsky"
elif [ -d "${SCRIPT_DIR}/../indi_allsky" ]; then
    APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
elif [ -d "/usr/share/indi-allsky" ]; then
    APP_DIR="/usr/share/indi-allsky"
else
    APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

if [ -x "/var/lib/indi-allsky/venv/bin/python3" ]; then
    PYTHON_BIN="/var/lib/indi-allsky/venv/bin/python3"
elif [ -x "${APP_DIR}/virtualenv/indi-allsky/bin/python3" ]; then
    PYTHON_BIN="${APP_DIR}/virtualenv/indi-allsky/bin/python3"
elif [ -x "${APP_DIR}/.venv/bin/python3" ]; then
    PYTHON_BIN="${APP_DIR}/.venv/bin/python3"
else
    PYTHON_BIN="python3"
fi
export PYTHONPATH="${APP_DIR}:${PYTHONPATH:-}"

show_help() {
    cat <<EOF
INDI Allsky Command-Line Control & Maintenance Utility

Usage:
  indi-allsky-ctl <command> [options/arguments...]

User & Authentication Management:
  passwd / reset-pass      Reset or change password for a web user
  user-add                 Create a new web user account
  user-list                List all configured web users
  user-del                 Delete a web user account

Database & Storage:
  backup-db                Create an immediate database backup
  fix-perms                Restore standard ownership & permissions (as in setup.sh)
  expire-images            Run image retention expiration and storage purge
  rebuild-thumbnails       Regenerate missing image thumbnails
  convert-db               Convert database between SQLite and MySQL
  validate-db              Audit database schema and repair broken records
  flush-images             Purge historical images/videos for a camera from DB
  flush-16min-images       Purge images taken within last 16 minutes from DB
  merge-cameras            Migrate records and images from one camera ID to another
  optimize-mysql           Optimize MySQL / MariaDB database tables
  import-darks             Interactively import dark frames and bad pixel maps
  retry-uploads            Manually sync / retry pending uploads (images/videos/API)
  notify                   Inject an alert notification into the database

Hardware & Diagnostics:
  test-camera              Run diagnostic camera capture test
  list-cameras             List detected INDI cameras
  camera-info              Display detailed sensor and capability info for cameras
  camera-props             List all INDI driver properties exposed by camera
  test-linearity           Perform camera sensor exposure linearity test
  test-sensors             Probe and read connected hardware sensors
  test-devices             Test fans, dew heaters, and GPIO output devices
  test-upload              Test file transfer protocols (SFTP/FTP/S3/Sync API)
  test-adsb                Test ADS-B aircraft tracking receiver connection
  test-oci                 Validate Oracle Cloud Infrastructure (OCI) credentials
